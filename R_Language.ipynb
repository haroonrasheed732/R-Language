   "source": [
    "checkresult <- function(marks){\n",
    "    if (marks >= 90){\n",
    "        return(\"Pass and Your Grade is A+\")\n",
    "    }else if(marks >=80){\n",
    "        return(\"Pass and Your Grade is B\")\n",
    "    } else if(marks >= 70){\n",
    "        return(\"Pass and Your Grade is C\")\n",
    "    } else if(marks >= 60){\n",
    "        return(\"Pass and Your Grade is D\")\n",
    "    }else {\n",
    "        return(\"Fail try again later\")\n",
    "    }\n",
    "}\n",
    "checkresult(80)        \n",
    "checkresult(90)        \n",
    "checkresult(70)        \n",
    "checkresult(60)        \n",
    "checkresult(50)        \n"
   ]
  },
